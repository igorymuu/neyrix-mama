# Neyrix Mama production environment schema. Do not place real secrets in Git.
ENVIRONMENT=production
APP_URL=https://mama.neyrix-ai.ru

# Internal Compose service endpoints
DATABASE_URL=postgresql+psycopg://mama:CHANGE_ME@postgres:5432/mama
REDIS_URL=redis://redis:6379/0
API_INTERNAL_URL=http://backend:8000
STORAGE_BACKEND=local
STORAGE_DIR=/data/files

# Generated locally before first start
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
BOT_INTERNAL_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Required for the Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_MODE=webhook

# Optional until the corresponding integrations are enabled
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_SUBJECTS=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Optional S3 storage; keep empty for local encrypted named volume
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional until payments are enabled
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
